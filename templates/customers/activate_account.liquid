<section class="section-spacing"><div class="page-width" style="max-width:460px;">
  <h1>{{ 'customer.activate_account.title' | t }}</h1>
  <p class="text-muted">{{ 'customer.activate_account.subtext' | t }}</p>
  {%- form 'activate_customer_password', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="apwd">{{ 'customer.activate_account.password' | t }}</label>
    <input type="password" id="apwd" name="customer[password]" autocomplete="new-password">
    <label for="apwd2">{{ 'customer.activate_account.password_confirmation' | t }}</label>
    <input type="password" id="apwd2" name="customer[password_confirmation]" autocomplete="new-password">
    <div style="display:flex; gap:8px; margin-top:16px;">
      <button type="submit" name="commit" class="btn">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--outline">{{ 'customer.activate_account.cancel' | t }}</button>
    </div>
  {%- endform -%}
</div></section>
