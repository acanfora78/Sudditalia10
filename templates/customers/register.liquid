<section class="section-spacing"><div class="page-width" style="max-width:460px;">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="First">{{ 'customer.register.first_name' | t }}</label>
    <input type="text" id="First" name="customer[first_name]" autocomplete="given-name">
    <label for="Last">{{ 'customer.register.last_name' | t }}</label>
    <input type="text" id="Last" name="customer[last_name]" autocomplete="family-name">
    <label for="Email">{{ 'customer.register.email' | t }}</label>
    <input type="email" id="Email" name="customer[email]" autocomplete="email" required>
    <label for="Password">{{ 'customer.register.password' | t }}</label>
    <input type="password" id="Password" name="customer[password]" autocomplete="new-password">
    <button type="submit" class="btn" style="margin-top:16px;">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
  <p style="margin-top:24px;"><a href="{{ routes.account_login_url }}">{{ 'customer.register.title' | t }} &rsaquo;</a></p>
</div></section>
