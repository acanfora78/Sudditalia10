{% render 'stile-sezione', section: section %}
<div class="section-spacing">
  <div class="page-width page-width--narrow">
    {%- if section.settings.title != blank -%}
      <h2>{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- form 'contact', class: 'account-form', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'contact.form.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="ContactName">{{ 'contact.form.name' | t }}</label>
      <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name }}">
      <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
      <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | default: customer.email }}">
      <label for="ContactMessage">{{ 'contact.form.message' | t }}</label>
      <textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      <button type="submit" class="btn" style="margin-top: 16px; align-self: flex-start;">{{ 'contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Modulo contatti",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Scrivici"
    },
    {
      "type": "header",
      "content": "Font della sezione"
    },
    {
      "type": "checkbox",
      "id": "sec_font_custom",
      "label": "Usa font diversi per questa sezione",
      "info": "Se spento, la sezione usa i font di Impostazioni tema → Tipografia.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "sec_font_heading",
      "label": "Font dei titoli",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "sec_font_body",
      "label": "Font dei testi",
      "default": "archivo_n4"
    },
    {
      "type": "select",
      "id": "sec_heading_case",
      "label": "Titoli",
      "options": [
        {
          "value": "theme",
          "label": "Come il tema"
        },
        {
          "value": "upper",
          "label": "Maiuscolo"
        },
        {
          "value": "none",
          "label": "Come scritti"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "sec_heading_spacing",
      "label": "Spaziatura lettere dei titoli",
      "min": -10,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "0 = come il tema."
    }
  ],
  "presets": [
    {
      "name": "Modulo contatti"
    }
  ]
}
{% endschema %}
