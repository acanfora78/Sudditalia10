{%- comment -%}
  Striscia social (stile Instagram).
  Nome del profilo grande a sinistra, bottone "Seguici" a destra, sotto una fila di foto
  verticali con gli angoli arrotondati che scorre in orizzontale.
  Le foto si caricano nei blocchi: Shopify non legge Instagram da solo senza un'app.
{%- endcomment -%}
{%- liquid
  assign profile_url = section.settings.link | default: settings.social_instagram
  assign handle = section.settings.title
  if handle == blank and profile_url != blank
    assign handle = profile_url | split: '?' | first | split: '/' | last
    if handle == blank
      assign parts = profile_url | split: '?' | first | split: '/'
      assign idx = parts.size | minus: 2
      assign handle = parts[idx]
    endif
    assign handle = '@' | append: handle
  endif
-%}

<div class="social page-width" data-pixel-reveal>
  <div class="social__head">
    <div>
      {%- if handle != blank -%}
        <h2 class="social__title">{{ handle | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="social__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- if profile_url != blank -%}
      <a class="btn btn--small" href="{{ profile_url }}" target="_blank" rel="noopener">
        {%- if section.settings.button_label != blank -%}
          {{- section.settings.button_label -}}
        {%- else -%}
          {{- 'sections.social.follow' | t -}}
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  <ul class="social__strip" role="list" style="--n: {{ section.blocks.size }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign link = block.settings.link | default: profile_url
      -%}
      <li class="social__item" {{ block.shopify_attributes }}>
        <a class="social__card" {% if link != blank %}href="{{ link }}" target="_blank" rel="noopener"{% endif %}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '720x' }}
          {%- elsif block.settings.image != blank -%}
            {% render 'responsive-image', image: block.settings.image, sizes: '(max-width: 749px) 62vw, 20vw', widths: '360, 480, 640, 800, 1000', alt: block.settings.image.alt %}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Striscia social",
  "tag": "section",
  "class": "section-social",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Nome del profilo",
      "info": "Se vuoto lo prende dal link Instagram in Impostazioni tema → Social."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Riga sotto il nome"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link del profilo",
      "info": "Se vuoto usa il link Instagram delle impostazioni del tema."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo del bottone",
      "info": "Se vuoto: \"Seguici\"."
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Foto o video",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Verticale (4:5)." },
        { "type": "video", "id": "video", "label": "Video (facoltativo)", "info": "Se c'è, si vede al posto della foto." },
        { "type": "url", "id": "link", "label": "Link (facoltativo)", "info": "Per esempio il post su Instagram." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Striscia social",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
