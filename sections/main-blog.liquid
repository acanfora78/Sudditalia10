{%- paginate blog.articles by 12 -%}
  <div class="page-width">
    <div class="page-head">
      <h1>{{ blog.title }}</h1>
    </div>
    <div class="articles">
      {%- for article in blog.articles -%}
        <a class="article-card" href="{{ article.url }}">
          {%- if article.image != blank -%}
            <div class="article-card__media">
              {% render 'responsive-image', image: article.image, sizes: '(max-width: 749px) 100vw, 33vw', widths: '400, 600, 800, 1200', alt: '' %}
            </div>
          {%- endif -%}
          <h2>{{ article.title }}</h2>
          <p class="text-muted text-small">{{ article.published_at | time_tag: format: 'date' }}</p>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": []
}
{% endschema %}
