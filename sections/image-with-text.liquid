<div class="section-spacing">
  <div class="page-width">
    <div class="split{% if section.settings.layout == 'image_right' %} split--reverse{% endif %}" style="--split-ratio: {{ section.settings.ratio }};">
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          {% render 'responsive-image', image: section.settings.image, sizes: '(max-width: 749px) 100vw, 50vw', widths: '480, 720, 960, 1280, 1600' %}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="split__body">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Immagine con testo",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Formato immagine",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "Quadrato"
        },
        {
          "value": "4 / 5",
          "label": "Verticale 4:5"
        },
        {
          "value": "3 / 2",
          "label": "Orizzontale 3:2"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posizione immagine",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "A sinistra"
        },
        {
          "value": "image_right",
          "label": "A destra"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo",
      "default": "<p>Racconta qui il brand: dove nascono i capi, i materiali, il taglio.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo del bottone"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del bottone"
    }
  ],
  "presets": [
    {
      "name": "Immagine con testo"
    }
  ]
}
{% endschema %}
