{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<div class="section-spacing">
  <div class="page-width">
    <div class="section-head">
      <h2>{{ section.settings.title | default: collection.title }}</h2>
      {%- if collection != blank and section.settings.link_label != blank -%}
        <a class="link-underline" href="{{ collection.url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="grid" style="--cols: {{ section.settings.columns }};">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="card">
            <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__info">
              <h3 class="card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Prodotti in evidenza",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "info": "Se vuoto usa il nome della collezione."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo del link alla collezione",
      "default": "Vedi tutto"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Prodotti da mostrare",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colonne su desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Prodotti in evidenza"
    }
  ]
}
{% endschema %}
