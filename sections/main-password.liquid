<div class="password">
  <div class="password__inner">
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- else -%}
      <p>{{ 'general.password.message' | t }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prospect, password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'sections.footer.newsletter_success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="password__form">
          <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.label' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
          <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__enter">
      <summary>{{ 'general.password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="password__form">
          <label class="visually-hidden" for="StorePassword">{{ 'general.password.label' | t }}</label>
          <input id="StorePassword" type="password" name="password" placeholder="{{ 'general.password.label' | t }}" autocomplete="current-password">
          <button type="submit" class="btn">{{ 'general.password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Pagina password",
  "tag": "section",
  "settings": []
}
{% endschema %}
