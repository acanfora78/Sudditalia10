{% render 'stile-sezione', section: section %}
<div class="section-spacing">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="statement{% if section.settings.align == 'center' %} statement--center{% endif %}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank or section.settings.button_label != blank -%}
      <div class="statement__text">
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn statement__cta" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Frase in grande",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Frase"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo del bottone"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del bottone"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Allineamento",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Sinistra"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ]
    },
    {
      "type": "header",
      "content": "Font della sezione"
    },
    {
      "type": "checkbox",
      "id": "sec_font_custom",
      "label": "Usa font diversi per questa sezione",
      "info": "Se spento, la sezione usa i font di Impostazioni tema → Tipografia.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "sec_font_heading",
      "label": "Font dei titoli",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "sec_font_body",
      "label": "Font dei testi",
      "default": "archivo_n4"
    },
    {
      "type": "select",
      "id": "sec_heading_case",
      "label": "Titoli",
      "options": [
        {
          "value": "theme",
          "label": "Come il tema"
        },
        {
          "value": "upper",
          "label": "Maiuscolo"
        },
        {
          "value": "none",
          "label": "Come scritti"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "sec_heading_spacing",
      "label": "Spaziatura lettere dei titoli",
      "min": -10,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "0 = come il tema."
    }
  ],
  "presets": [
    {
      "name": "Frase in grande"
    }
  ]
}
{% endschema %}
