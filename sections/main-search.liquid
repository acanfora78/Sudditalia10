{% render 'stile-sezione', section: section %}
{{ 'griglie.css' | asset_url | stylesheet_tag }}
<script src="{{ 'griglie.js' | asset_url }}" defer></script>
<div class="page-width">
  <div class="page-head">
    <h1>{% if section.settings.title != blank %}{{ section.settings.title | escape }}{% else %}{{ 'general.search.title' | t }}{% endif %}</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- else -%}
        <p class="text-muted">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>

        {%- assign has_products = false -%}
        {%- capture products_html -%}
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- assign has_products = true -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if has_products -%}
          <div class="grid" style="--cols: 4; margin-top: 24px;">{{ products_html }}</div>
        {%- endif -%}

        <div class="search-results">
          {%- for item in search.results -%}
            {%- unless item.object_type == 'product' -%}
              <a class="search-result" href="{{ item.url }}">
                <h3>{{ item.title }}</h3>
                <p class="text-muted">{{ item.content | strip_html | truncatewords: 30 }}</p>
              </a>
            {%- endunless -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ricerca",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "info": "Se vuoto usa il testo predefinito."
    },
    {
      "type": "header",
      "content": "Font della sezione"
    },
    {
      "type": "checkbox",
      "id": "sec_font_custom",
      "label": "Usa font diversi per questa sezione",
      "info": "Se spento, la sezione usa i font di Impostazioni tema → Tipografia.",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "sec_font_heading",
      "label": "Font dei titoli",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "sec_font_body",
      "label": "Font dei testi",
      "default": "archivo_n4"
    },
    {
      "type": "select",
      "id": "sec_heading_case",
      "label": "Titoli",
      "options": [
        {
          "value": "theme",
          "label": "Come il tema"
        },
        {
          "value": "upper",
          "label": "Maiuscolo"
        },
        {
          "value": "none",
          "label": "Come scritti"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "sec_heading_spacing",
      "label": "Spaziatura lettere dei titoli",
      "min": -10,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "0 = come il tema."
    }
  ]
}
{% endschema %}
