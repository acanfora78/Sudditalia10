{%- comment -%}
  Immagine responsive con srcset e dimensioni esplicite (niente salti di layout).

  Parametri:
    image         (obbligatorio) oggetto immagine Shopify
    sizes         attributo sizes (default: 100vw)
    widths        larghezze srcset separate da virgola
    class         classe CSS
    loading       'lazy' (default) o 'eager'
    fetchpriority opzionale ('high' per l'immagine principale della pagina)
    alt           testo alternativo (default: quello dell'immagine)
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '100vw'
  assign loading = loading | default: 'lazy'
  assign widths = widths | default: '320, 480, 640, 800, 1000, 1400, 1800'
  assign alt_text = alt | default: image.alt | escape
  assign width_list = widths | split: ','
-%}
{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 1000 }}"
    srcset="
      {%- for w in width_list -%}
        {%- assign wt = w | strip | plus: 0 -%}
        {{ image | image_url: width: wt }} {{ wt }}w{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    "
    sizes="{{ sizes }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    alt="{{ alt_text }}"
    loading="{{ loading }}"
    {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    decoding="async"
    {% if class %}class="{{ class }}"{% endif %}
  >
{%- endif -%}
